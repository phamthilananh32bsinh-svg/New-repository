        // --- DRAWING LOGIC ---
        function setupDrawing() {
            const svg = document.getElementById('svgContainer');
            const dots = document.querySelectorAll('.connect-dot');

            // Reliable coordinate calc relative to SVG container
            function getDotCenter(dot) {
                const containerRect = svg.getBoundingClientRect();
                const dotRect = dot.getBoundingClientRect();
                return {
                    x: dotRect.left - containerRect.left + dotRect.width / 2,
                    y: dotRect.top - containerRect.top + dotRect.height / 2
                };
            }

            function updateLines() {
                connections.forEach(conn => {
                    const p1 = getDotCenter(conn.source);
                    const p2 = getDotCenter(conn.target);
                    conn.line.setAttribute('x1', p1.x); conn.line.setAttribute('y1', p1.y);
                    conn.line.setAttribute('x2', p2.x); conn.line.setAttribute('y2', p2.y);
                });
                if (currentDrawing) {
                    const p1 = getDotCenter(currentDrawing.sourceDot);
                    currentDrawing.line.setAttribute('x1', p1.x); currentDrawing.line.setAttribute('y1', p1.y);
                }
            }
            
            window.addEventListener('resize', updateLines);
            window.addEventListener('scroll', updateLines, { passive: true, capture: true });

            function removeConnection(lineElement) {
                const idx = connections.findIndex(c => c.line === lineElement);
                if (idx !== -1) {
                    const conn = connections[idx];
                    let srcId = conn.source.dataset.id;
                    let tgtId = conn.target.dataset.id;

                    // 1-Time Change Lock
                    if (dotChanges[srcId] >= 1 || dotChanges[tgtId] >= 1) {
                        playLockSound();
                        showToast("Bạn đã hết lượt đổi đáp án cho từ này! 🔒", false);
                        conn.line.setAttribute('stroke', '#ff4757'); 
                        setTimeout(() => conn.line.setAttribute('stroke', '#747d8c'), 1000);
                        return;
                    }

                    dotChanges[srcId] = (dotChanges[srcId] || 0) + 1;
                    dotChanges[tgtId] = (dotChanges[tgtId] || 0) + 1;

                    if (dotChanges[srcId] >= 1) {
                        conn.source.classList.add('locked-dot');
                        conn.source.innerHTML = '<i class="fas fa-lock text-[10px] text-white absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2"></i>';
                    }
                    if (dotChanges[tgtId] >= 1) {
                        conn.target.classList.add('locked-dot');
                        conn.target.innerHTML = '<i class="fas fa-lock text-[10px] text-white absolute top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2"></i>';
                    }

                    conn.source.classList.remove('active');
                    conn.target.classList.remove('active');
                    svg.removeChild(lineElement);
                    connections.splice(idx, 1);
                    playRemoveSound();
                    checkAllConnected();
                }
            }

            dots.forEach(dot => {
                dot.addEventListener('click', (e) => {
                    const existingConn = connections.find(c => c.source === dot || c.target === dot);
                    if (existingConn) return; 

                    if (!currentDrawing) {
                        currentDrawing = { sourceDot: dot, line: document.createElementNS('http://www.w3.org/2000/svg', 'line') };
                        const p = getDotCenter(dot);
                        currentDrawing.line.setAttribute('x1', p.x); currentDrawing.line.setAttribute('y1', p.y);
                        currentDrawing.line.setAttribute('x2', p.x); currentDrawing.line.setAttribute('y2', p.y);
                        currentDrawing.line.setAttribute('stroke', '#a4b0be');
                        currentDrawing.line.setAttribute('stroke-width', '5');
                        currentDrawing.line.setAttribute('stroke-dasharray', '8,6');
                        currentDrawing.line.classList.add('connect-line');
                        svg.appendChild(currentDrawing.line);
                        dot.classList.add('active');
                        playConnectSound();
                    } else {
                        if (currentDrawing.sourceDot.dataset.side !== dot.dataset.side) {
                            const p2 = getDotCenter(dot);
                            currentDrawing.line.setAttribute('x2', p2.x); currentDrawing.line.setAttribute('y2', p2.y);
                            currentDrawing.line.setAttribute('stroke', '#747d8c');
                            currentDrawing.line.removeAttribute('stroke-dasharray');
                            
                            const currentLine = currentDrawing.line;
                            currentLine.addEventListener('click', () => removeConnection(currentLine));
                            
                            connections.push({ source: currentDrawing.sourceDot, target: dot, line: currentDrawing.line });
                            dot.classList.add('active');
                            
                            if(isMusicPlaying) playConnectSound();

                            currentDrawing = null;
                            checkAllConnected();
                        } else {
                            svg.removeChild(currentDrawing.line);
                            currentDrawing.sourceDot.classList.remove('active');
                            currentDrawing = null;
                        }
                    }
                });
            });

            document.addEventListener('mousemove', (e) => {
                if (currentDrawing) {
                    const containerRect = svg.getBoundingClientRect();
                    currentDrawing.line.setAttribute('x2', e.clientX - containerRect.left);
                    currentDrawing.line.setAttribute('y2', e.clientY - containerRect.top);
                }
            });
            
            document.addEventListener('click', (e) => {
                if (currentDrawing && !e.target.classList.contains('connect-dot')) {
                    svg.removeChild(currentDrawing.line);
                    currentDrawing.sourceDot.classList.remove('active');
                    currentDrawing = null;
                }
            });
        }

