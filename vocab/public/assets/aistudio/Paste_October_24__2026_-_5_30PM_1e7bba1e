            document.getElementById('screenRoundSelect').classList.add('hidden');
            document.getElementById('screenRoundSelect').classList.remove('flex');
            
            document.getElementById('screenSplash').classList.remove('hidden');
            
            showToast("Đã lưu điểm thành công! 🏆", true);
        });

        loadLeaderboard();
    </script>
