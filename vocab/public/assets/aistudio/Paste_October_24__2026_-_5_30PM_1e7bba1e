            {"r":14,"n":"Yếu tố môi trường 2","w":[["Temperature","Nhiệt độ"],["CO2 concentration","Nồng độ CO2"],["Humidity","Độ ẩm"],["Mineral element","Nguyên tố khoáng"]]},
            {"r":15,"n":"Khái niệm & Chỉ số","w":[["Light compensation point","Điểm bù ánh sáng"],["Light saturation point","Điểm bão hòa ánh sáng"],["CO2 compensation point","Điểm bù CO2"],["CO2 saturation point","Điểm bão hòa CO2"],["Photosynthesis intensity","Cường độ quang hợp"],["Respiration intensity","Cường độ hô hấp"],["Respiration","Hô hấp"]]},
            {"r":16,"n":"Năng suất","w":[["Yield","Năng suất"],["Biological yield","Năng suất sinh học"],["Economic yield","Năng suất kinh tế"],["Economic coefficient","Hệ số kinh tế"],["Dry matter mass","Khối lượng chất khô"],["Economic organ","Cơ quan kinh tế"]]},
            {"r":17,"n":"Động từ chuyên ngành 1","w":[["Synthesize","Tổng hợp"],["Absorb","Hấp thụ"],["Release","Giải phóng"],["Convert","Chuyển hóa"],["Fix","Cố định"],["Reduce","Khử"],["Oxidize","Oxy hóa"]]},
            {"r":18,"n":"Động từ chuyên ngành 2","w":[["Diffuse","Khuếch tán"],["Transport","Vận chuyển"],["Accumulate","Tích lũy"],["Regulate","Điều hòa"],["Promote","Xúc tiến"],["Stimulate","Kích thích"],["Regenerate","Tái sinh"],["Decompose","Phân giải"]]},
