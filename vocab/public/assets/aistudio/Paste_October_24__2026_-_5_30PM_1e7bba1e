        const roundsData = rawVocabData.map(d => ({
            id: d.r,
            title: `Vòng ${d.r}: ${d.n}`,
            pairs: d.w.map(p => ({ en: p[0], vi: p[1] }))
        }));

        const EMOJIS = ['🍀','🌿','🍃','🌱','🌺','🌸','🌼','🌻','🌾','🍄','🌳','🌵','🪴'];

        // --- STATE VARIABLES ---
        let completedRounds = [];
        let totalScore = 0;
        let playerName = "";
        let currentRoundObj = null;
        let connections = []; 
        let currentDrawing = null; 
        let gameMode = 'en-vi'; 
        let comboCount = 0;
        let dotChanges = {};
        
        // --- AUDIO SYSTEM ---
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        let isMusicPlaying = false;
        let bgmInterval;

        function playTone(freq, type, duration, vol) {
            if(audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gainNode = audioCtx.createGain();
            osc.type = type; osc.frequency.value = freq;
            osc.connect(gainNode); gainNode.connect(audioCtx.destination);
            osc.start();
            gainNode.gain.setValueAtTime(vol, audioCtx.currentTime);
            gainNode.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
            osc.stop(audioCtx.currentTime + duration);
        }

        const scales = [[261.63, 293.66, 329.63, 392.00, 440.00], [220.00, 261.63, 293.66, 329.63, 392.00]];
        function playBGMNote() {
            if(!isMusicPlaying) return;
            const scale = scales[Math.floor(Math.random() * scales.length)];
            const freq = scale[Math.floor(Math.random() * scale.length)];
            playTone(freq, 'sine', 2.5, 0.05);
            bgmInterval = setTimeout(playBGMNote, 500 + Math.random() * 1000);
        }
        
        function toggleBGM(forceState = null) {
            isMusicPlaying = forceState !== null ? forceState : !isMusicPlaying;
