            {"r":6,"n":"Quá trình quang hợp 2","w":[["CO2 fixation","Cố định CO2"],["CO2 reduction","Khử CO2"],["CO2 assimilation","Đồng hóa CO2"],["Acceptor regeneration","Tái sinh chất nhận"],["Acceptor","Chất nhận"]]},
