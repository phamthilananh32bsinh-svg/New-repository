        function playWrongSound() { playTone(250, 'sawtooth', 0.4, 0.1); }
        
        // BUG FIX: Guaranteed Victory Fanfare Function
        function playVictoryEDM() {
            if(audioCtx.state === 'suspended') audioCtx.resume();
            
            // Get fresh currentTime right when function is called
            const now = audioCtx.currentTime;
            
            // Arpeggio progression for Victory (C5, E5, G5, C6)
            const notes = [
                { f: 523.25, offset: 0.0, dur: 0.15 },
                { f: 659.25, offset: 0.15, dur: 0.15 },
                { f: 783.99, offset: 0.30, dur: 0.15 },
                { f: 1046.50, offset: 0.45, dur: 0.60 }
            ];
            
            notes.forEach((n, index) => {
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                
                // Use square/sawtooth for EDM feel
                osc.type = (index === notes.length - 1) ? 'square' : 'sawtooth';
                osc.frequency.value = n.f;
                
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                
                const startTime = now + n.offset;
                osc.start(startTime);
                
                // Volume envelope
                gain.gain.setValueAtTime(0, startTime);
                gain.gain.linearRampToValueAtTime(0.15, startTime + 0.02);
                gain.gain.exponentialRampToValueAtTime(0.001, startTime + n.dur);
                
                osc.stop(startTime + n.dur);
            });
        }

