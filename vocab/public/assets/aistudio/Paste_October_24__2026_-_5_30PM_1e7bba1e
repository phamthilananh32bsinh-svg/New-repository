            {"r":8,"n":"Năng lượng 2","w":[["NADPH","NADPH"],["NADP+","NADP+"],["Chemical bond","Liên kết hóa học"],["Electron","Electron"],["Proton","Proton"]]},
            {"r":9,"n":"Chất hữu cơ","w":[["Organic compound","Chất hữu cơ"],["Carbohydrate","Carbohydrate"],["Glucose","Glucose"],["Protein","Protein"],["Lipid","Lipid"],["Nucleic acid","Nucleic acid"],["Amino acid","Amino acid"]]},
            {"r":10,"n":"Nhóm thực vật","w":[["C3 plants","Thực vật C3"],["C4 plants","Thực vật C4"],["CAM plants","Thực vật CAM"],["Sun-loving plant","Cây ưa sáng"],["Shade-loving plant","Cây ưa bóng"],["Succulent plant","Cây mọng nước"]]},
            {"r":11,"n":"Cấu trúc lá 1","w":[["Leaf","Lá"],["Stoma","Khí khổng"],["Leaf vein","Gân lá"],["Leaf surface","Bề mặt lá"],["Leaf area","Diện tích lá"]]},
