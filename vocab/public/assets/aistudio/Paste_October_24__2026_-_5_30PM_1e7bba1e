            {"r":20,"n":"Cụm từ quan trọng 1","w":[["Synthesize organic compounds","Tổng hợp chất hữu cơ"],["Raw materials","Nguyên liệu đầu vào"],["Final products","Sản phẩm cuối cùng"],["Chemical bonds","Liên kết hóa học"],["Electron transport chain","Chuỗi truyền electron"],["Proton gradient","Gradient proton"],["Greenhouse effect","Hiệu ứng nhà kính"]]},
            {"r":21,"n":"Cụm từ quan trọng 2","w":[["Heterotrophic organisms","Sinh vật dị dưỡng"],["Autotrophic organisms","Sinh vật tự dưỡng"],["Metabolic process","Quá trình trao đổi chất"],["Physiological adaptation","Thích nghi sinh lý"],["Planting density","Mật độ trồng"],["Rational fertilization","Bón phân hợp lý"],["Proper irrigation","Tưới tiêu hợp lý"],["Appropriate care","Chăm sóc phù hợp"],["Arid environment","Môi trường khô hạn"],["Desert region","Vùng sa mạc"],["Tropical region","Vùng nhiệt đới"],["Temperate zone","Vùng ôn đới"]]}
